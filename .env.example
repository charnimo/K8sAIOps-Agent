# Copy this file to .env and replace placeholder values.
# Do not commit .env; it contains real secrets.

# Agent model used by both chat and monitoring agents.
AIOPS_AGENT_MODEL=meta/llama-3.3-70b-instruct
LLM_MODEL=meta/llama-3.3-70b-instruct

# Add as many comma-separated keys as you have.
# The app tries them in order and rotates to the next key on auth, quota,
# rate-limit, timeout, or provider 5xx failures.
AIOPS_AGENT_API_KEYS=replace-with-key-1,replace-with-key-2,replace-with-key-3

# Optional aliases for the monitoring graph. Leave unset when using
# AIOPS_AGENT_API_KEYS above.
# NVIDIA_API_KEYS=replace-with-key-1,replace-with-key-2,replace-with-key-3
# LLM_API_KEYS=replace-with-key-1,replace-with-key-2,replace-with-key-3

# Legacy single-key format is still supported for compatibility.
# AIOPS_AGENT_API_KEY=replace-with-one-key
# NVIDIA_API_KEY=replace-with-one-key
# LLM_API_KEY=replace-with-one-key

NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=180

# Local development defaults.
AIOPS_READ_ONLY_MODE=false
AIOPS_ENABLE_MUTATIONS=true
AIOPS_DEBUG_MODE=true

# Kubernetes documentation RAG.
# Run scripts/index_kubernetes_docs.py before expecting retrieval results.
AIOPS_K8S_DOCS_RAG_ENABLED=true
AIOPS_K8S_DOCS_REPO_URL=https://github.com/kubernetes/website.git
AIOPS_K8S_DOCS_SOURCE_PATH=data/kubernetes-website
AIOPS_K8S_DOCS_INDEX_PATH=data/k8s-docs-index
AIOPS_K8S_DOCS_VERSION=latest
AIOPS_K8S_DOCS_TOP_K=5
AIOPS_K8S_DOCS_CHUNK_CHARS=1800
AIOPS_K8S_DOCS_VECTOR_ENABLED=true
AIOPS_K8S_DOCS_VECTOR_PATH=data/k8s-docs-vectors
AIOPS_K8S_DOCS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AIOPS_K8S_DOCS_HYBRID_BM25_WEIGHT=0.55
AIOPS_K8S_DOCS_HYBRID_VECTOR_WEIGHT=0.45
