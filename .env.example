# Copy this file to .env and fill in your real values.
# .env is gitignored by default.

LLM_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-your-real-key
LLM_MODEL=mistralai/mistral-small-4-119b-2603
# Optional overrides
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=2000
# NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
