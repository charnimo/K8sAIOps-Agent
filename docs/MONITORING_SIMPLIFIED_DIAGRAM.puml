@startuml K8sAIOps-Complete-Monitoring
!theme plain
skinparam backgroundColor #f5f5f5
skinparam defaultFontSize 10

title K8sAIOps Agent - Complete Monitoring System (Simplified)

package "DATA SOURCES" {
    component "Kubernetes\nCluster" as K8s {
        note bottom
            Events API
            Pod Objects
            Namespace Objects
        end note
    }
}

package "MONITORING CORE" {
    component "Watcher" as W1 {
        note right
            watch_events()
            watch_pods()
            watch_namespaces()
        end note
    }

    component "EventProcessor" as P1 {
        note right
            Normalize raw K8s objects
            into enriched events
        end note
    }

    component "Enrichment Layer" as E1 {
        component "Classifier" as C1
        component "TeamResolver" as T1
        component "DedupCache" as D1
    }
}

package "TEAM DISCOVERY" {
    database "NamespaceTeamCache" as NTC {
        note bottom
            namespace → [teams]
            (TTL-based refresh)
        end note
    }

    component "Resolution Strategy" as RS {
        note bottom
            1. Resource labels
            2. Namespace labels
            3. tools.namespaces
            4. FALLBACK_TEAM
        end note
    }
}

package "EVENT MODEL" {
    entity "EnrichedEvent" as EE {
        event_id: str
        severity: Severity
        namespace: str
        resource_name: str
        reason: str
        teams: list[str]
        timestamp: str
        labels: dict
        annotations: dict
    }
}

package "SUBSCRIPTION & ROUTING" {
    database "SubscriptionRegistry" as SR {
        note bottom
            Map WebSocket → Subscription
            user_id, namespaces, teams, 
            severities, role
        end note
    }

    component "EventMatcher" as EM {
        note right
            Filter subscribers by:
            - Severity match
            - Namespace match
            - Team overlap
        end note
    }
}

package "DELIVERY" {
    component "Dispatcher" as DISP {
        note right
            Query registry
            Send JSON to WebSockets
            Store in history
        end note
    }

    database "EventHistory" as EH {
        note bottom
            In-memory deque
            Max 500 events
        end note
    }

    component "WebSocket\nServer" as WSS {
        note right
            Port: 8765 (default)
            Handles multiple
            concurrent connections
        end note
    }
}

package "DASHBOARDS" {
    component "Dashboard A\n(platform-ops)" as DA
    component "Dashboard B\n(backend-team)" as DB
    component "Dashboard C\n(admin)" as DC
}

' === Connections ===

K8s --> W1: stream

W1 --> P1: raw objects

P1 --> C1: severity\nclassification
P1 --> T1: team\nresolution
P1 --> D1: dedup\ncheck

T1 --> NTC: query
NTC --> RS: resolve teams
RS --> T1: teams[]

C1 --> EE: enrich
T1 --> EE: enrich
D1 --> EE: enrich

EE --> DISP: dispatch

DISP --> SR: get_subscribers

SR --> EM: all subscriptions
EM --> DISP: matching targets

DISP --> EH: append
DISP --> WSS: send JSON

WSS --> DA: WebSocket push
WSS --> DB: WebSocket push
WSS --> DC: WebSocket push

DA -.-> WSS: subscribe + connect
DB -.-> WSS: subscribe + connect
DC -.-> WSS: subscribe + connect

' === Legend ===

note right of K8s
    FLOW:
    ──→  Direct data flow
    ········→  Message/subscription

    KEY CONCEPTS:
    • Teams discovered dynamically from K8s labels
    • Events delivered to subscribers matching filters
    • WebSocket used for real-time push (not polling)
    • Severity auto-classified from K8s event semantics
end note

@enduml
